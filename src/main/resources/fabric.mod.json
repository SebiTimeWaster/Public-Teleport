{
    "schemaVersion": 1,
    "id": "public-teleport",
    "version": "${version}",
    "name": "Public Teleport",
    "description": "An easy to use Fabric Teleport Mod: Homes, Warps, Back, Spawn, TPA; Server-side or client-side; Minimal pre-defined configuration.",
    "authors": ["TimeWaster"],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "MIT",
    "icon": "assets/public-teleport/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["timewaster.publicteleport.PublicTeleport"]
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": ">=${minecraft_version}",
        "java": ">=${java_version}",
        "fabric-api": "*"
    }
}
